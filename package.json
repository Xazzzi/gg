{
  "name": "@xazzzi/gg",
  "version": "0.2.0",
  "description": "Tiny zero-dependency concurrent primitives for modern JavaScript/TypeScript",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "type": "tsc --noEmit",
    "lint": "biome check",
    "pretest": "node generate-tests-index.ts",
    "test": "node --expose-gc --test --test-timeout=250 --test-reporter=dot tests/index.test.ts",
    "test:human": "node --expose-gc --test --test-timeout=250 --experimental-test-coverage tests/index.test.ts",
    "examples": "node update-spec-examples.ts",
    "test:branches": "node find-uncovered-branches.ts",
    "test:perf": "node tests/perf.ts",
    "test:mutations": "npm run pretest && stryker run; node generate-surviving-mutants.ts",
    "test:redundant": "npm run pretest && node find-redundant-tests.ts",
    "checks": "npm run type && npm run lint && npm run test && node update-spec-examples.ts --check"
  },
  "keywords": [
    "generator",
    "channel",
    "select",
    "pipe",
    "async",
    "flow"
  ],
  "author": "Vitalii Yakovenko",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xazzzi/gg.git"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@stryker-mutator/core": "10.1.1",
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "overrides": {
    "minimatch": "11.0.3",
    "qs": "6.17.1"
  }
}
