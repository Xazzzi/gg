{
  "name": "@xazzzi/gg",
  "version": "0.2.3",
  "description": "Tiny zero-dependency concurrent primitives and a JSX DOM runtime for modern JavaScript/TypeScript",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx.d.ts",
      "default": "./dist/jsx.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx.d.ts",
      "default": "./dist/jsx.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "SKILL.md"
  ],
  "scripts": {
    "type": "tsc --noEmit && tsc -p devtools --noEmit",
    "lint": "biome check",
    "pretest": "node generate-tests-index.ts",
    "test": "node --expose-gc --test --test-timeout=250 --test-reporter=dot tests/index.test.ts",
    "test:human": "node --expose-gc --test --test-timeout=250 --experimental-test-coverage tests/index.test.ts",
    "test:branches": "node find-uncovered-branches.ts",
    "test:browser": "playwright test",
    "test:perf": "node tests/perf.ts",
    "bench": "node tests/bench.ts",
    "test:mutations": "npm run pretest && stryker run; node generate-surviving-mutants.ts",
    "test:survivors": "npm run pretest && node rerun-survivors.ts; node generate-surviving-mutants.ts",
    "test:redundant": "npm run pretest && node find-redundant-tests.ts",
    "checks": "npm run type && npm run lint && npm run test && node update-spec-examples.ts --check",
    "build": "npm run build:index && npm run build:devtools",
    "build:index": "tsc -p tsconfig.build.json",
    "build:devtools": "tsc -p devtools && node devtools/link.ts",
    "minify": "echo 'export * from \"./dist/index.js\"; export * from \"./dist/jsx.js\";' | esbuild --bundle --minify --format=esm --outfile=dist/index.min.js",
    "postbuild": "npm run minify",
    "prepack": "npm run build",
    "spec:examples": "node update-spec-examples.ts",
    "learn": "esbuild learn-gg.tsx --bundle --platform=node --format=esm --log-level=warning | node --input-type=module",
    "serve:examples": "esbuild examples/todomvc/dist/main=examples/todomvc/src/main.tsx examples/bench/dist/main=examples/bench/src/main.tsx examples/orbits/dist/main=examples/orbits/src/main.tsx examples/forms/dist/main=examples/forms/src/main.tsx --bundle --sourcemap --format=esm --outdir=. --servedir=. --serve=localhost:5173"
  },
  "keywords": [
    "generator",
    "channel",
    "select",
    "pipe",
    "async",
    "flow",
    "jsx",
    "dom",
    "reactive"
  ],
  "author": "Vitalii Yakovenko",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xazzzi/gg.git"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.65.1",
    "@stryker-mutator/core": "10.1.1",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "overrides": {
    "minimatch": "11.0.3",
    "qs": "6.17.1"
  }
}
