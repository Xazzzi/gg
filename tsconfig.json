{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "target": "esnext",
    "module": "esnext",
    "lib": ["ESNext", "DOM"],
    "noEmit": true
  },
  "include": ["src", "tests"]
}
