{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "target": "esnext",
    "module": "nodenext",
    "lib": ["ESNext", "DOM"],
    "types": ["node"],
    "jsx": "react-jsx",
    "jsxImportSource": "@xazzzi/gg",
    "paths": {
      "@xazzzi/gg": ["./src/index.ts"],
      "@xazzzi/gg/jsx-runtime": ["./src/jsx.ts"]
    },
    "noEmit": true
  },
  "include": ["src", "tests", "examples", "learn-gg.ts"]
}
